{
  "name": "dsh-reading",
  "version": "0.9.4",
  "private": false,
  "description": "在 DeepSeek Harness 里读书：导入 EPUB / MOBI / AZW3 / TXT / PDF，分页阅读、目录、进度、五色划线、笔记与书签。锚点用 EPUB CFI，数据落在你自己的磁盘上，AI 状态诊断与读书蒸馏。0.9.0 加 Legado 书源导入与搜书。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "client/vendor",
    "client/src",
    "client/build.mjs",
    "schema",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "jsdom": "^30.1.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node client/build.mjs",
    "build:check": "node client/build.mjs --check",
    "fixtures": "node golden/make-fixtures.mjs",
    "golden": "node golden/run.mjs",
    "test": "node test/run.mjs",
    "verify": "node --check index.js && node client/build.mjs --check && node golden/run.mjs && node test/run.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "epub",
    "reader",
    "cfi",
    "annotation",
    "ebook"
  ],
  "author": "dsh-Reading contributors",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulibuld/dsh-reading.git"
  },
  "bugs": {
    "url": "https://github.com/hulibuld/dsh-Reading/issues"
  },
  "homepage": "https://github.com/hulibuld/dsh-Reading#readme"
}
